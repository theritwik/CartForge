# Copy to .env. Read by Docker Compose, the API, and the Prisma CLI.
# These values are for local development only.

# PostgreSQL container
POSTGRES_USER=cartforge
POSTGRES_PASSWORD=cartforge_local_dev
POSTGRES_DB=cartforge
POSTGRES_PORT=5432

# Redis container
REDIS_PORT=6379

# API
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
# Origin the web app is served from. State-changing API requests must come from it.
WEB_ORIGIN=http://localhost:3000
# The web app proxies /api to the API, so one proxy hop is trusted for client IPs.
TRUST_PROXY_HOPS=1
# Must match the PostgreSQL and Redis values above.
DATABASE_URL=postgresql://cartforge:cartforge_local_dev@localhost:5432/cartforge
REDIS_URL=redis://localhost:6379

# Payments (Stripe test mode only; live keys are rejected)
# Leave both empty to use the local development payment simulator, which is not Stripe.
# With a key: use a test-mode secret key (sk_test_...) from the Stripe dashboard and the
# signing secret (whsec_...) printed by `stripe listen --forward-to localhost:4000/api/v1/payments/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Automated tests
# Tests connect only to this database, never to DATABASE_URL. The name must end
# in _test. It is created and migrated automatically on the first test run.
TEST_DATABASE_URL=postgresql://cartforge:cartforge_local_dev@localhost:5432/cartforge_test
