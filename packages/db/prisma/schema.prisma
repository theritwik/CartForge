generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All monetary columns are integer paise (INR minor units).
// CHECK constraints and the order-item immutability trigger are defined in the
// migration SQL because Prisma schema cannot express them. See docs/database.md.

enum UserRole {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  // Money was collected for an order that could not be fulfilled; a refund is owed.
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Stored lowercase; the application normalises before writing.
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  cart             Cart?
  orders           Order[]
  stockAdjustments StockAdjustment[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  // SHA-256 hash of the opaque session token. The token itself is never stored.
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  name             String
  slug             String        @unique
  description      String
  pricePaise       Int           @map("price_paise")
  status           ProductStatus @default(DRAFT)
  // Units physically in stock, and the part of them held by unpaid orders.
  // Available to buy = stockQuantity - reservedQuantity.
  stockQuantity    Int           @default(0) @map("stock_quantity")
  reservedQuantity Int           @default(0) @map("reserved_quantity")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  // Price sorting across the whole catalog.
  @@index([status, pricePaise, id])
  // Substring search (ILIKE '%term%'). Needs the pg_trgm extension, created in the migration.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

// One row per administrator stock adjustment, written in the same transaction as the
// change. Rows are never updated. Reservations and sales are recorded on orders instead.
model StockAdjustment {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  // Units added (positive) or removed (negative). Never zero (CHECK in the migration SQL).
  delta      Int
  // Physical stock straight after the change.
  stockAfter Int      @map("stock_after")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  admin   User    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([adminId])
  @@map("stock_adjustments")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String   @map("alt_text")
  // Display order. Position 0 is the primary image.
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                   String      @id @default(uuid(7)) @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  // Chosen by the client for one checkout attempt. Repeating a request with the same key
  // returns the order it created instead of creating another.
  idempotencyKey       String      @map("idempotency_key") @db.Uuid
  status               OrderStatus @default(PENDING_PAYMENT)
  totalPaise           Int         @map("total_paise")
  shippingName         String      @map("shipping_name")
  shippingPhone        String      @map("shipping_phone")
  shippingAddressLine1 String      @map("shipping_address_line1")
  shippingAddressLine2 String?     @map("shipping_address_line2")
  shippingCity         String      @map("shipping_city")
  shippingState        String      @map("shipping_state")
  shippingPostalCode   String      @map("shipping_postal_code")
  // Set while the order holds a stock reservation awaiting payment.
  reservationExpiresAt DateTime?   @map("reservation_expires_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
  // Recent orders and the dashboard sales trend, across all customers.
  @@index([createdAt, id])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  // Snapshot of the product at purchase time. Rows are immutable (database trigger).
  productName    String   @map("product_name")
  unitPricePaise Int      @map("unit_price_paise")
  quantity       Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

// One row per payment attempt. An order may have several attempts but only one
// PENDING at a time (partial unique index in the migration SQL).
model Payment {
  id                      String        @id @default(uuid(7)) @db.Uuid
  orderId                 String        @map("order_id") @db.Uuid
  status                  PaymentStatus @default(PENDING)
  amountPaise             Int           @map("amount_paise")
  // Set once the hosted checkout page exists at the payment provider.
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id")
  checkoutUrl             String?       @map("checkout_url")
  checkoutExpiresAt       DateTime      @map("checkout_expires_at") @db.Timestamptz(3)
  // Set when the provider reports the money as collected.
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id")
  stripeRefundId          String?       @map("stripe_refund_id")
  // Why the attempt failed or must be refunded, for support and reconciliation.
  failureReason           String?       @map("failure_reason")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// Webhook events already handled. Inserting the event id in the same transaction
// as its effects makes a redelivered event a no-op.
model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_stripe_events")
}
